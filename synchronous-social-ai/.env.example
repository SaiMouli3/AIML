# ── Runtime ─────────────────────────────────────────────────────────────
# development | test | demo | staging | production. Mock providers are impossible in staging/production.
APP_ENV=development
# Public base URL. Used for OAuth redirects, signed media URLs (Meta fetches media by URL) and webhooks.
APP_URL=http://localhost:3000
# PostgreSQL connection string. Must NOT be a superuser in production (superusers bypass row-level security).
DATABASE_URL=postgres://sync:sync@localhost:5432/sync_dev
# >= 32 random characters. Signs file URLs and other HMACs. `openssl rand -base64 48`
SESSION_SECRET=
# 32 random bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM). `openssl rand -base64 32`
ENCRYPTION_KEY=
LOG_LEVEL=info

# ── Object storage ──────────────────────────────────────────────────────
# local (filesystem, dev only) | s3 (any S3-compatible store)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── LLM gateway (OpenAI-compatible chat completions) ────────────────────
# Default: Experiential Labs gateway. Leave LLM_API_KEY empty to use the labelled development mock.
LLM_BASE_URL=https://api.experientiallabs.ai/v1
LLM_API_KEY=
LLM_MODEL_DEFAULT=claude-sonnet-5.5
LLM_MODEL_FAST=claude-haiku-5.5
LLM_TIMEOUT_MS=60000

# ── Meta (Instagram, Facebook Pages + Marketing API — one Meta app) ─────
META_APP_ID=
META_APP_SECRET=
# Random string you also enter in the Meta App Dashboard webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# true = ads are created PAUSED and never activated (no spend). Set false only after launch checklist.
META_ADS_TEST_MODE=true

# ── Threads (separate Threads app ID/secret from the same Meta app dashboard) ──
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_GRAPH_HOST=https://graph.threads.com
THREADS_AUTHORIZE_URL=https://threads.com/oauth/authorize

# ── X (OAuth 2.0 confidential client; scopes tweet.read tweet.write users.read media.write offline.access) ──
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_BASE=https://api.x.com

# ── TikTok (Login Kit + Content Posting API; verify your media URL domain for PULL_FROM_URL) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_BASE=https://open.tiktokapis.com

# ── Higgsfield media generation ─────────────────────────────────────────
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Random string appended to the hf_webhook callback URL so deliveries can be authenticated.
HIGGSFIELD_WEBHOOK_TOKEN=

# ── Worker ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_TENANT_CONCURRENCY=2
# Set to false to hide development mocks even in development.
ALLOW_MOCK_PROVIDERS=
